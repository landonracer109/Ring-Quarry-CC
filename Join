-- join (installer + boot loader) -- ComputerCraft 1.63
-- Run ONCE on each turtle, from the floppy:
--   disk/join miner <laneId>     for a mining turtle (lane 0..15)
--   disk/join service            for the service turtle
--
-- It wipes whatever run the turtle was part of (a fresh start), copies
-- itself onto the turtle as "boot" and makes it run on every boot. From then on the turtle gets its program from the main (control)
-- computer: at every boot it asks for the latest version, saves it if it
-- changed, and runs it. If the main computer doesn't answer, it runs the
-- copy it already has.

local DEPLOY_PROTOCOL = "chunkdeploy"
local WAIT = 40 -- seconds to wait for the main computer at boot (it answers
              -- one turtle a second, so after an update some wait a while)

local args = { ... }
local role, lane = args[1], tonumber(args[2])
local me = shell.getRunningProgram()

if (role ~= "miner" and role ~= "service") or (role == "miner" and not lane) then
  print("Usage: " .. me .. " miner <laneId>   (lane 0..15)")
  print("       " .. me .. " service")
  return
end
local program = (role == "miner") and "m" or "s"
local label = (role == "miner") and ("lane " .. lane) or "service"

-- Installing (run as "join" from the floppy): copy ourselves as "boot" and
-- make it run on every boot.
if fs.getName(me) ~= "boot" then
  -- joining = a fresh start: forget any run this turtle was part of
  for _, name in ipairs({ ".quarry_state_a", ".quarry_state_b", ".quarry_log_a",
      ".quarry_log_b", ".service_state_a", ".service_state_b", ".service_log_a",
      ".service_log_b", ".quarry_away" }) do
    fs.delete(name)
  end
  if fs.exists("boot") then fs.delete("boot") end
  fs.copy(me, "boot")
  local f = fs.open("startup", "w")
  if role == "miner" then
    f.write('shell.run("boot", "miner", "' .. lane .. '")\n')
  else
    f.write('shell.run("boot", "service")\n')
  end
  f.close()
  print("Joined as " .. label .. ". It now updates and starts by itself on every boot.")
end

-- Boot loader ---------------------------------------------------------------
local opened = false
for _, side in ipairs(rs.getSides()) do
  if peripheral.getType(side) == "modem" then
    rednet.open(side)
    opened = true
  end
end
if not opened then
  error("No modem attached! Attach a wireless modem and reboot.")
end

local function read_file(path)
  if not fs.exists(path) then return nil end
  local f = fs.open(path, "r")
  local text = f.readAll()
  f.close()
  return text
end

-- Same checksum as the main computer uses, to tell if our copy is current.
local function checksum(text)
  local h = 0
  for i = 1, #text do h = (h * 31 + text:byte(i)) % 2147483647 end
  return h
end

local mine = read_file(program)
local have = mine and checksum(mine) or nil

print("Checking the main computer for updates...")
local got_answer = false
local waiting_said = false
local last_ask = -math.huge
sleep(1) -- (a message may have gone out just before this reboot: the server allows 1 a second)
local deadline = os.clock() + WAIT
while true do
  if os.clock() - last_ask >= 10 then -- (the server allows few messages)
    rednet.broadcast({ cmd = "want", role = role, lane = lane, have = have }, DEPLOY_PROTOCOL)
    last_ask = os.clock()
  end
  local _, msg = rednet.receive(DEPLOY_PROTOCOL, 1)
  if type(msg) == "table" and msg.role == role then
    if msg.cmd == "program" and type(msg.code) == "string" and loadstring(msg.code) then
      -- write a new file first, then swap, so a restart never leaves half a program
      local f = fs.open(program .. ".new", "w")
      f.write(msg.code)
      f.close()
      if fs.exists(program) then fs.delete(program) end
      fs.move(program .. ".new", program)
      print(mine and "Updated to the newest version." or "Program installed.")
      got_answer = true
      break
    elseif msg.cmd == "current" then
      print("Already up to date.")
      got_answer = true
      break
    end
  end
  if os.clock() > deadline then
    -- no answer in time: carry on with our copy, or keep asking if we
    -- don't have one yet
    if fs.exists(program) then break end
    if not waiting_said then
      print("No program yet - waiting for the main computer...")
      waiting_said = true
    end
  end
end
if not got_answer then print("No answer from the main computer; using my current copy.") end

if role == "miner" then
  shell.run(program, tostring(lane))
else
  shell.run(program)
end

  local t = term
  local w, h = t.getSize()
  local state, state_color = run_state()
  row(t, 1, {
    { VERSION .. " ", colors.lightBlue },
    { string.format("L=%d D=%s chunk %d/%s ", length, depth_text(), current_chunk,
      chunks == 0 and "inf" or tostring(last_chunk_no())), colors.white },
    { state, state_color },
  })
  local y = 2
  for _, lane in ipairs(sorted_lanes()) do
    if y > h - 2 then break end
    local m = miners[lane]

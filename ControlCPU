local last_draw = -math.huge
local last_draw_error
local redraw_due = false
local function draw_all(force)
  if not force and os.clock() - last_draw < 1 then
    if not redraw_due then
      redraw_due = true
      os.queueEvent("redraw") -- (maintenance_loop draws it a second later)
    end
    return
  end
  redraw_due = false
  last_draw = os.clock()
  draw_terminal()
  if mon then
    local ok, err = pcall(draw_monitor)
    if not ok then
      -- e.g. the monitor was broken or resized mid-draw
      if err ~= last_draw_error then
        last_draw_error = err
        add_log("control", "Display error: " .. tostring(err))
      end
      find_monitor()
    end
  end
end

-- Fleet control ---------------------------------------------------------------
local function send(lane, msg)
  queue_send(miners[lane].id, msg, PROTOCOL)
end

-- Re-sent now and then (see maintenance_loop) until the lane says it's
-- heading home: it may have been restarting when the first one came.
function tell_stop(lane)
  send(lane, { cmd = "stop", id = lane })
  miners[lane].stop_sent = os.clock()
  if not stopped[lane] then
    stopped[lane] = true
    miners[lane].status = "stopped, going home"
    save_run()
  end
end

local function all_stopped()
  for lane in pairs(miners) do
    if not stopped[lane] then return false end
  end
  return true
end

local function check_all_home()
  if all_home or not next(miners) then return end
  for _, m in pairs(miners) do
    -- m.confirmed: the lane said so since we booted (after a server crash
    -- our saved notes can be ahead of the world)
    if not (m.home and m.confirmed) then return end
  end
  all_home = true
  clear_run() -- the run is over: next boot starts fresh
  if update_staged() then
    add_log("control", "All lanes are home. Installing the downloaded update...")
    draw_all(true)
    apply_update()
  end
  add_log("control", "All lanes are home. The next run starts with ENTER or START.")
  -- ready for the next run with the same settings
  started, started_at = false, nil
  current_chunk = 1
  skip = read_progress()
  done, stopped = {}, {}
  stop_requested, finished, last_chunk, all_home = false, false, false, false
  for _, m in pairs(miners) do
    m.home, m.at_home, m.confirmed, m.pass, m.chunk = nil, nil, nil, nil, nil
    m.status = "finished"
  end
end

-- Between runs, a turtle started by the boot loader that reports an old
-- program version is told to reboot (it fetches the new one as it boots).
local nudges = {} -- [computer id] = { count=, at= }
local function nudge_if_outdated(sender, role, version, who)
  if started or not version then return end
  local p = live_program(ROLE_PROGRAM[role])
  if not p or p.sum == version then return end
  local n = nudges[sender] or { count = 0, at = -math.huge }
  if n.count >= 3 or os.clock() - n.at < 30 then return end
  n.count, n.at = n.count + 1, os.clock()
  nudges[sender] = n
  queue_send(sender, { cmd = "update_reboot" }, DEPLOY_PROTOCOL)
  add_log("control", "Telling " .. who .. " to reboot into the newest version.")
end

-- Called when a lane reports chunk_done: if everyone is done, either move
-- the fleet to the next chunk or finish.
local function try_advance()
  for lane in pairs(miners) do
    if (done[lane] or 0) < current_chunk then return end
  end
  -- every lane has finished this chunk: remember it for the next run
  if current_chunk > read_progress() then write_progress(current_chunk) end
  if stop_requested or last_chunk or (chunks ~= 0 and current_chunk >= last_chunk_no()) then
    finished = true
    if stop_requested then
      add_log("control", "Stopped after chunk " .. current_chunk .. ". Lanes are heading home.")
    else
      add_log("control", "Run complete: mined up to chunk " .. current_chunk .. ". Lanes are heading home.")
    end
    for lane in pairs(miners) do tell_stop(lane) end
  else
    add_log("control", "All lanes finished chunk " .. current_chunk
      .. ". Moving to chunk " .. (current_chunk + 1) .. ".")
    current_chunk = current_chunk + 1
    -- one message every lane hears at once (they all set off together)
    queue_send(nil, { cmd = "next_chunk", chunk = current_chunk }, PROTOCOL)
    for lane in pairs(miners) do
      miners[lane].status = "to chunk " .. current_chunk
      miners[lane].pass = nil
    end
  end
  save_run()
end

-- Lane 0 may take the loaders back once every other lane is home and the
-- service turtle is back on its home row with nothing to do.
local function may_collect(lane)
  local waiting = {}
  for other, m in pairs(miners) do
    -- on its start spot (maybe still unloading) is out of the way too
    if other ~= lane and not ((m.home and m.confirmed) or m.at_home) then
      table.insert(waiting, "lane " .. other)
    end
  end
  table.sort(waiting)
  -- the service turtle only has to be on its home row (out of the lanes)
  if not service.on_row then
    table.insert(waiting, "the service turtle")
  end
  return #waiting == 0, waiting
end

local function handle(sender, msg)
  if type(msg) ~= "table" or type(msg.id) ~= "number" then return end
  local lane = msg.id
  local m = miners[lane]

  if msg.cmd == "hello" then
    nudge_if_outdated(sender, "miner", msg.version, "lane " .. lane)
    if m and m.id == sender then m.ver = msg.ver or "old" end
    if not started then
      if m and m.id ~= sender then
        add_log("control", "Two turtles claim lane " .. lane .. "! Check their lane numbers.")
      end
      if not m then add_log("control", "Lane " .. lane .. " registered.") end
      local changed = not m or m.id ~= sender
      miners[lane] = m or {}
      miners[lane].id = sender
      miners[lane].status = "registered"
      miners[lane].seen = os.clock()
      if changed or not msg.registered then send(lane, { cmd = "registered", id = lane }) end
      if changed then save_run() end
    elseif not m and not finished and not stop_requested then
      -- a lane that turned up after START (e.g. still fetching its
      -- program): join the run at the current chunk
      add_log("control", "Lane " .. lane .. " registered late: joining the run.")
      miners[lane] = { id = sender, status = "starting", seen = os.clock() }
      send(lane, { cmd = "start", id = lane, length = length, depth = depth,
        chunks = last_chunk_no(), chunk = current_chunk, skip = skip })
      save_run()
    elseif m and m.id == sender and not finished and not stop_requested and not stopped[lane] then
      -- it missed the start message, or was reset with "here": (re)join
      -- the run at the current chunk
      m.home, m.at_home, m.confirmed = nil, nil, nil
      send(lane, { cmd = "start", id = lane, length = length, depth = depth,
        chunks = last_chunk_no(), chunk = current_chunk, skip = skip })
    elseif m and m.id == sender and not (m.home and m.confirmed) then
      -- A turtle only says hello when it has no run left: this one is on
      -- its start spot. (Its "finished" may have been lost in a restart.)
      m.home, m.confirmed = true, true
      m.status = "finished"
      save_run()
      check_all_home()
    end
    return
  end

  -- everything else must come from a registered turtle
  if not m or m.id ~= sender then return end
  m.seen = os.clock()

  if msg.cmd == "may_collect" then
    local ok, waiting = may_collect(lane)
    if ok then
      if m.status ~= "collecting loaders" then
        add_log("control", "Everyone else is home: lane " .. lane .. " is picking up the loaders.")
      end
      m.status = "collecting loaders"
      send(lane, { cmd = "collect", id = lane })
    else
      m.status = "waiting for " .. waiting[1]
    end
  elseif msg.cmd == "chunk_done" then
    if msg.no_next_loader and not last_chunk then
      -- lane 0 couldn't load the next chunk, so nobody may drive into it:
      -- let everyone finish this chunk, then end the run
      last_chunk = true
      add_log("control", "No loader for the next chunk, so this chunk is the last one.")
    end
    if (done[lane] or 0) < msg.chunk then
      done[lane] = msg.chunk
      save_run()
    end
    m.chunk = msg.chunk
    if finished or stop_requested then
      tell_stop(lane)
    elseif msg.chunk < current_chunk then
      -- behind: it missed the next_chunk message, or a server crash put
      -- it back. Send it on to the chunk after the one it just finished.
      send(lane, { cmd = "next_chunk", id = lane, chunk = msg.chunk + 1 })
    else
      m.status = "chunk " .. msg.chunk .. " done, waiting"
      try_advance()
    end
  end
end

-- States a lane only ever reports while on its start spot.
local HOME_STATES = {
  ["home, unloading"] = true, ["waiting for service"] = true, ["unloading"] = true,
  ["stopped, at home"] = true, ["finished"] = true,
}

-- States that show a lane got its "stop" (no need to send it again).
local STOP_HEARD = {
  ["going home"] = true, ["stopped, at home"] = true, ["home, unloading"] = true,
  ["finished"] = true, ["waiting to collect loaders"] = true, ["collecting loaders"] = true,
}

-- Status updates from the miners and the service turtle (dashboard only).
local function handle_status(sender, msg)
  if type(msg) ~= "table" then return end
  if msg.cmd == "service" then
    service.state, service.lane, service.queue = msg.state, msg.lane or nil, msg.queue
    service.fuel, service.stock, service.seen = msg.fuel, msg.stock, os.clock()
    service.on_row = msg.on_row
    nudge_if_outdated(sender, "service", msg.version, "the service turtle")
    service.ver = msg.ver or "old"
    for _, text in ipairs(msg.texts or { msg.text }) do
      service.last_text = text
      add_log("service", text)
    end
  elseif msg.cmd == "status" and type(msg.id) == "number" then
    local m = miners[msg.id]
    if m and m.id == sender then
      m.seen = os.clock()
      m.ver = msg.ver or "old"
      local info = msg.info
      if type(info) == "table" then
        m.chunk, m.pass, m.y, m.fuel = info.chunk, info.pass, info.y, info.fuel
        m.trash = info.trash
        if type(info.depth) == "number" and info.depth ~= depth then
          depth = info.depth
          add_log("control", "Bedrock found: mining " .. depth .. " layers deep.")
          save_run()
        end
      end
      if msg.state == "working" and m.pass then msg.state = "mining pass " .. m.pass end
      if msg.state then m.status = msg.state end
      if msg.state and STOP_HEARD[msg.state] then m.stop_heard = true end
      -- on its start spot (all servicing happens there): out of the way
      if msg.state then m.at_home = HOME_STATES[msg.state] or nil end
      if msg.state == "finished" then
        m.confirmed = true
        if not m.home then
          m.home = true
          save_run()
        end
      end
      if msg.state == "resuming" or msg.state == "recovered after crash" then
        -- restarted with a run on: not home (a crash may have put it back
        -- in the tunnel after it had got home)
        m.at_home, m.confirmed = nil, nil
        if m.home then
          m.home = nil
          save_run()
        end
        -- STOP pressed: it may have missed it while restarting. (After a
        -- normal finish a crash can put a lane back mid-chunk: it mines
        -- that chunk again and is told to stop when it reports it done.)
        m.stop_heard = nil
        if stop_requested then
          tell_stop(msg.id)
        elseif stopped[msg.id] then
          stopped[msg.id] = nil
          save_run()
        end
      end
    end
    for _, text in ipairs(msg.texts or { msg.text }) do
      add_log("lane " .. msg.id, text)
    end
    -- what else the lane had to tell us rides along with its status
    if type(msg.hello) == "table" then
      handle(sender, { cmd = "hello", id = msg.id, version = msg.hello.version, ver = msg.ver,
        registered = msg.hello.registered })
    end
    if type(msg.chunk_done) == "table" then
      handle(sender, { cmd = "chunk_done", id = msg.id, chunk = msg.chunk_done.chunk,
        no_next_loader = msg.chunk_done.no_next_loader })
    end
    if msg.may_collect then handle(sender, { cmd = "may_collect", id = msg.id }) end
    check_all_home()
  end
end

-- Main ----------------------------------------------------------------------
local function network_loop()
  while true do
    local sender, msg, protocol = rednet.receive() -- (sleeps until one comes)
    if protocol == PROTOCOL then
      handle(sender, msg)
    elseif protocol == STATUS_PROTOCOL then
      handle_status(sender, msg)
    end
    draw_all(false)
  end
end

-- Uploads text to a paste site (no account needed) and returns its web
-- address, or nil and why not. (pastebin's old API no longer works.)
local function upload(text)
  if not http then return nil, "HTTP is turned off on this server" end
  local r = http.post("https://paste.rs/", text)
  if r then
    local url = (r.readAll() or ""):match("https?://%S+")
    r.close()
    if url then return url end
  end
  r = http.post("https://dpaste.com/api/v2/",
    "expiry_days=30&content=" .. textutils.urlEncode(text))
  if r then
    local url = (r.readAll() or ""):match("https?://%S+")
    r.close()
    if url then return url .. ".txt" end
  end
  return nil, "paste.rs and dpaste.com both refused (blocked by the server?)"
end

-- L key: every turtle uploads its own log (they report the web address,
-- which lands in our log), and a minute later our log goes up too: that
-- one address has everything.
local log_timer
local function collect_logs()
  -- (one message that every turtle hears)
  queue_send(nil, { cmd = "upload_log" }, PROTOCOL)
  add_log("control", "Asked every turtle to upload its log. The full log goes up in a minute...")
  log_timer = os.startTimer(60)
end

local function upload_quarry_log()
  local text = read_file(LOG_FILE) or ""
  if #text > 150000 then text = "...(older lines left out)\n" .. text:sub(-150000) end
  local url, why = upload("Quarry log (" .. VERSION .. "), lanes: " .. #sorted_lanes() .. "\n" .. text)
  if url then
    add_log("control", "ALL LOGS: " .. url .. "  <- send this address")
    local h = fs.open("logs_url.txt", "w")
    h.writeLine(url)
    h.close()
  else
    add_log("control", "Couldn't upload the log: " .. tostring(why))
  end
  draw_all(true)
end

-- Wakes up for a redraw the throttle held back, and otherwise every 15 s:
-- to refresh the clocks on the dashboard, and to send "stop" again to a
-- lane that hasn't said it's heading home.
local function maintenance_loop()
  local timer = os.startTimer(15)
  local redraw_timer
  while true do
    local ev = { os.pullEvent() }
    if ev[1] == "redraw" and not redraw_timer then
      redraw_timer = os.startTimer(1)
    elseif ev[1] == "timer" and ev[2] == log_timer then
      log_timer = nil
      upload_quarry_log()
    elseif ev[1] == "timer" and ev[2] == redraw_timer then
      redraw_timer = nil
      draw_all(false)
    elseif ev[1] == "timer" and ev[2] == timer then
      timer = os.startTimer(started and 15 or 60) -- (between runs: once a minute)
      if started and (stop_requested or finished) then
        for lane, m in pairs(miners) do
          if stopped[lane] and not m.stop_heard and not (m.home and m.confirmed)
              and os.clock() - (m.stop_sent or 0) >= 120 then
            tell_stop(lane)
          end
        end
      end
      draw_all(false)
    end
  end
end

local function run_update()
  add_log("control", "Downloading the newest programs from GitHub...")
  draw_all(true)
  local ok, err = download_update()
  term.clear()
  forget_screen(term)
  if not ok then
    add_log("control", err)
  elseif started then
    add_log("control", "Update downloaded: it installs when this run is over.")
  else
    add_log("control", "Update downloaded: installing and restarting everything...")
    draw_all(true)
    apply_update()
  end
end

-- SAVE on the settings panel (same as answering the questions after C).
local function save_settings()
  chunks = math.max(0, panel.chunks)
  write_progress(math.max(0, panel.mined))
  skip = read_progress()
  local f = fs.open(SETTINGS_FILE, "w")
  f.write(length .. "\n0\n" .. chunks .. "\n")
  f.close()
  save_run()
  add_log("control", string.format("Settings saved: %s, %d mined before (driven past).",
    chunks == 0 and "until stopped" or (chunks .. " chunks"), skip))
end

local function touched(name)
  if name == "start" then
    panel = nil
    do_start()
  elseif name == "stop" then
    confirm_stop_until = os.clock() + 5
  elseif name == "confirm_stop" then
    confirm_stop_until = 0
    do_stop()
  elseif name == "update" then
    confirm_update_until = os.clock() + 5
  elseif name == "confirm_update" then
    confirm_update_until = 0
    run_update()
  elseif name == "logs" then
    collect_logs()
  elseif name == "settings" and not started then
    if panel then
      panel = nil
    else
      panel = { chunks = chunks, mined = read_progress() }
    end
  elseif name == "cancel" then
    panel = nil
  elseif name == "save" and panel then
    save_settings()
    panel = nil
  elseif panel then
    local key, amount = name:match("^([cm])([%-%+]%d+)$")
    if key == "c" then panel.chunks = math.max(0, panel.chunks + tonumber(amount)) end
    if key == "m" then panel.mined = math.max(0, panel.mined + tonumber(amount)) end
  end
end

local function ui_loop()
  while true do
    local ev = { os.pullEvent() }
    local e = ev[1]
    if e == "key" then
      if ev[2] == keys.enter then
        do_start()
      elseif ev[2] == keys.s then
        do_stop()
      elseif ev[2] == keys.q and (not started or all_stopped()) then
        return
      elseif ev[2] == keys.u then
        run_update()
      elseif ev[2] == keys.l then
        collect_logs()
      elseif ev[2] == keys.c and not started then
        local h = fs.open(ASK_FILE, "w")
        h.write("ask for the settings on the next boot\n")
        h.close()
        os.reboot()
      end
      draw_all(true)
    elseif e == "monitor_touch" then
      local x, y = ev[3], ev[4]
      for _, b in ipairs(buttons) do
        if y >= b.y and y <= (b.y2 or b.y) and x >= b.x1 and x <= b.x2 then
          touched(b.name)
          break
        end
      end
      draw_all(true)
    elseif e == "monitor_resize" or e == "peripheral" or e == "peripheral_detach" then
      find_monitor()
      draw_all(true)
    end
  end
end

